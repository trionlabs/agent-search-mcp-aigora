{
  "name": "@aigora/mcp",
  "version": "0.1.1",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "Aigora MCP bridge for the Celo ERC-8004 agent registry and bounty tools.",
  "homepage": "https://github.com/trionlabs/agent-search-mcp-aigora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trionlabs/agent-search-mcp-aigora.git"
  },
  "bugs": {
    "url": "https://github.com/trionlabs/agent-search-mcp-aigora/issues"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/",
    "skills/",
    "README.md",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "aigora-mcp": "bin/mcp.js"
  },
  "main": "dist/cli.js",
  "exports": {
    ".": "./dist/cli.js",
    "./skill": "./skills/aigora-mcp.md"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {},
  "overrides": {
    "express-rate-limit": "8.7.1",
    "fast-uri": "3.1.9",
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "~1.32.2",
    "@types/node": "^22.7.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.6"
  }
}
